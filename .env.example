# Kopieren nach .env und ausfüllen. Alles ist optional – ohne Werte läuft die App im Dev-Modus.

# Google Login (OAuth Client ID, Typ "Webanwendung").
# Autorisierte JavaScript-Quellen: http://localhost:8080 und https://<host>.<tailnet>.ts.net
# Ohne Client-ID ist ein einfacher Dev-Login (Name + E-Mail) aktiv.
GOOGLE_CLIENT_ID=
# Kommagetrennte E-Mails, die automatisch Admin werden (zusätzlich wird der erste Nutzer Admin).
ADMIN_EMAILS=
# Dev-Login trotz Google-Client-ID erzwingen (true/false)
DEV_LOGIN=false

# Google Maps: Browser-Key (Maps JavaScript API) – per HTTP-Referrer beschränken.
GOOGLE_MAPS_API_KEY=
# Optional eigener Server-Key (Routes API + Places API (New)). Fallback: GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_SERVER_KEY=
# Optional eigene Map-ID (für Advanced Markers). Fallback: DEMO_MAP_ID
GOOGLE_MAPS_MAP_ID=

# KI-Assistent: OpenAI-kompatible Chat-Completions-API.
# Default: GitHub Models (Copilot) – API-Key = GitHub PAT mit Berechtigung "models:read".
# Kann auch im Admin-Dashboard gesetzt werden.
LLM_BASE_URL=https://models.github.ai/inference
LLM_MODEL=openai/gpt-4.1
LLM_API_KEY=
