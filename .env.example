# Kopieren nach .env und ausfüllen. Alles ist optional – ohne Werte läuft die App im Dev-Modus.

# Tailscale: nicht-ephemerer Auth-Key für das Tailnet (siehe docs/ENTWICKLER.md).
# Ohne Key und gespeicherten Zustand kann sich der Sidecar nicht automatisch anmelden.
TS_AUTHKEY=
# Nur für OAuth-Client-Secrets mit zugehörigem Tag:
# TS_EXTRA_ARGS=--advertise-tags=tag:neugier

# Google Login (OAuth Client ID, Typ "Webanwendung").
# Autorisierte JavaScript-Quellen: http://localhost:8080 und https://neugier.<tailnet>.ts.net
# Ohne Client-ID ist ein einfacher Dev-Login (Name + E-Mail) aktiv.
GOOGLE_CLIENT_ID=
# Kommagetrennte E-Mails, die automatisch Admin werden (zusätzlich wird der erste Nutzer Admin).
ADMIN_EMAILS=
# Dev-Login trotz Google-Client-ID erzwingen (true/false)
DEV_LOGIN=false

# Google Maps: Browser-Key (Maps JavaScript API) – per HTTP-Referrer beschränken.
GOOGLE_MAPS_API_KEY=
# Optional eigener Server-Key (Routes API + Places API (New)). Fallback: GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_SERVER_KEY=
# Optional eigene Map-ID (für Advanced Markers). Fallback: DEMO_MAP_ID
GOOGLE_MAPS_MAP_ID=

# KI-Assistent: copilot oder openai. Auch im Admin-Dashboard konfigurierbar.
LLM_PROVIDER=copilot
LLM_MODEL=auto
LLM_API_KEY=
LLM_WEB_SEARCH=on
# Nur für OpenAI-kompatible Anbieter:
# LLM_BASE_URL=https://api.openai.com/v1
# TAVILY_API_KEY=
